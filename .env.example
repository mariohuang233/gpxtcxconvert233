# Set these in your deployment environment; the app does not auto-load this file.
HOST=0.0.0.0
PORT=8080
DATA_DIR=/data
# Generate independent values with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_TOKEN=
# Set 1 when serving the public site through HTTPS.
COOKIE_SECURE=0
